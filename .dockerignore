# Send only inputs used by the root Dockerfile; Git ignores do not protect a build context.
**
!Dockerfile
!.dockerignore
!bootstrap.sh
!container-logging.mjs
!auth/
!auth/*.mjs
!patches/
!patches/restrict-mcp-environment.patch
!patches/inherit-working-directory.patch
!patches/runtime-dependencies.patch
!DesktopCommanderMCP/
!DesktopCommanderMCP/package.json
!DesktopCommanderMCP/package-lock.json
!DesktopCommanderMCP/tsconfig.json
!DesktopCommanderMCP/setup-claude-server.js
!DesktopCommanderMCP/uninstall-claude-server.js
!DesktopCommanderMCP/track-installation.js
!DesktopCommanderMCP/scripts/
!DesktopCommanderMCP/scripts/build-ui-runtime.cjs
!DesktopCommanderMCP/src/
!DesktopCommanderMCP/src/**
!DesktopCommanderMCP/vendor/
!DesktopCommanderMCP/vendor/**

# Keep local secrets and generated files excluded even inside an allowed source directory.
**/.git
**/.git/**
**/.env
**/.env.*
**/.npmrc
**/.yarnrc
**/.yarnrc.yml
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/*.log
**/*.key
**/*.pem
**/*.pem.*
**/*.pfx
**/*.p12
**/.netrc
**/.git-credentials
**/.ssh
**/.ssh/**
**/.aws
**/.aws/**
**/.config
**/.config/**
**/id_rsa*
**/id_ed25519*
**/.DS_Store
